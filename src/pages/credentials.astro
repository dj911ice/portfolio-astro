---
import React from "react";
import Layout from "../layouts/Layout.astro";
import CredentialsComponent from "../components/Credentials";
import {credentialsStatic} from "../utils/credentials";

let credentials = credentialsStatic;

try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 100000)
    const response = await fetch('https://portfolio-backend-gogin.onrender.com/api/credentials', {
        signal: controller.signal
    });
    clearTimeout(timeout);

    if (response.ok) {
        credentials = await response.json();
    }
} catch (error) {
    console.error("DATA FETCH FAILED:", error);
}
---

<Layout title = "JPD: Credentials">
    <CredentialsComponent client:load credentials={credentials} />
</Layout>